DATABASE_URL="postgres://user:password@host.neon.tech/neondb?sslmode=require"
AUTH_SECRET="generate with: npx auth secret"

# Vercel Blob read-write token, used by src/app/api/photos/upload/route.ts to
# issue signed client-upload tokens. `vercel env pull` fills this in once the
# Blob store is provisioned; scripts/backup.sh needs its own copy (see that
# file's header) since it runs on the Pi5, not on Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Used once by `npm run db:seed` to create the 2 accounts (no public signup route).
SEED_USER_1_EMAIL="you@example.com"
SEED_USER_1_NAME="Your Name"
SEED_USER_1_PASSWORD="choose-a-real-password"
SEED_USER_2_EMAIL="partner@example.com"
SEED_USER_2_NAME="Partner Name"
SEED_USER_2_PASSWORD="choose-a-real-password"
